#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve `uv.lock`, each task script's lockfile, `.mise/mise.lock`, and `docs/bun.lock` against their manifests"

source "$MISE_PROJECT_ROOT/.mise/lib/lock.sh"

mise lock
uv lock --no-locked
lock_scripts --no-locked
bun install --cwd docs --lockfile-only
