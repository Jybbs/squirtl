#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify `uv.lock` and `.mise/mise.lock` against their manifests"

refuse() {
  echo "$report" >&2
  exit 1
}

restore() {
  cmp -s "$snapshot" .mise/mise.lock || mv "$snapshot" .mise/mise.lock
  rm -f "$snapshot"
}

uv lock --check
snapshot=$(mktemp "${TMPDIR:-/tmp}/mise.lock.XXXXXX")
trap 'rm -f "$snapshot"' EXIT
cp -p .mise/mise.lock "$snapshot"
trap restore EXIT
report=$(MISE_LOG_LEVEL=warn MISE_QUIET=0 mise lock 2>&1) || refuse
[[ "$report" != *"failed to resolve"* ]] || refuse
diff -u "$snapshot" .mise/mise.lock >&2
