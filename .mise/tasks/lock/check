#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify `uv.lock`, each task script's lockfile, and `.mise/mise.lock` against their manifests, and that every tool the project pins installs from `.mise/mise.lock`"

source "$MISE_PROJECT_ROOT/.mise/lib/lock.sh"

restore() {
  cmp -s "$snapshot" .mise/mise.lock || mv "$snapshot" .mise/mise.lock
  rm -f "$snapshot"
}

uv lock --check
lock_scripts --check
snapshot=$(mktemp "${TMPDIR:-/tmp}/mise.lock.XXXXXX")
trap 'rm -f "$snapshot"' EXIT
cp -p .mise/mise.lock "$snapshot"
trap restore EXIT
report=$(MISE_LOG_LEVEL=warn MISE_QUIET=0 mise lock 2>&1) \
  && [[ "$report" != *"failed to resolve"* ]] \
  || { echo "$report" >&2; exit 1; }
diff -u "$snapshot" .mise/mise.lock >&2
mise install --dry-run --force
