#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "draw"
#MISE depends     = ["site:install"]
#MISE description = "Rewrite every mark the site's `MARKS` registry lists from the drawing it names, then the README's preview of the front page's walks"

node_modules/.bin/vitest run \
  --config docs/.vitepress/config/vitest.ts \
  --update=all \
  tests/site/lib/config/marks.test.ts

node --input-type=module <<'NODE'
import { writePreviews } from "./docs/.vitepress/lib/readme/preview.ts"
writePreviews(import.meta.url)
NODE
