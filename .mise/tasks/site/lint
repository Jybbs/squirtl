#!/usr/bin/env -S bash -euo pipefail
#MISE depends     = ["site:install"]
#MISE description = "Lint the site's TypeScript and its suite with Oxlint, as annotations under GitHub Actions, and fail on a line past 110 characters"

format=default
[[ -z "${GITHUB_ACTIONS:-}" ]] || format=github
status=0

node_modules/.bin/oxlint \
  --config docs/.vitepress/config/.oxlintrc.json \
  --format "$format" \
  "$@" \
  docs/.vitepress tests/site \
  || status=$?

node --input-type=module <<'NODE' || status=$?
import { lintLines } from "./docs/.vitepress/lib/proof/lines.ts"
lintLines(import.meta.url)
NODE

exit "$status"
