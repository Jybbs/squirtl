#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Install the site's packages into `docs/node_modules` from `docs/bun.lock`, pruning any package the lockfile no longer names, and link `tests/site/node_modules` to them"
#MISE dir         = "docs"

bun install --frozen-lockfile
bun prune
ln -sfn ../../docs/node_modules ../tests/site/node_modules
