#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "affected"
#MISE description = "Run the tests the files changed since the merge base with `main` reach, uncommitted and untracked files included, passing any further arguments to pytest"

importers() {
  local imported=() path
  while IFS= read -r path; do
    case "$path" in
      src/*.py | tests/common/*.py | tests/conftest.py)
        imported+=("$path") ;;
      *)
        echo "$path" ;;
    esac
  done
  (( ! ${#imported[@]} )) \
    || python3 "${BASH_SOURCE[0]%/*}/reach.py" "$base" "${imported[@]}"
}

naming() {
  grep \
    --exclude-dir fixtures \
    --include '*.py' \
    -lFr \
    -- "$1" tests \
    || true
}

reach() {
  local path rest
  while IFS= read -r path; do
    case "$path" in
      "")
        ;;
      pyproject.toml | uv.lock | .mise/config.toml | .mise/mise.lock)
        echo tests ;;
      src/squirtl/cli/__init__.py)
        printf '%s\n' tests/cli/app.py "$path" ;;
      src/squirtl/*.py)
        printf '%s\n' "tests/${path#src/squirtl/}" "$path" ;;
      tests/*/fixtures/*/*)
        rest=${path#*/fixtures/}
        echo "${path%%/fixtures/*}/${rest%%/*}.py" ;;
      tests/conftest.py)
        if (( $# )); then echo tests; else echo "$path"; fi ;;
      tests/*/conftest.py)
        echo "${path%/*}" ;;
      tests/*.py)
        echo "$path" ;;
      .mise/tasks/*/*)
        rest=${path#.mise/tasks/}
        echo "tests/tasks/${rest%%/*}.py" ;;
      .mise/bin/*)
        echo tests/tasks/bin.py ;;
      src/squirtl/*/*)
        rest=${path#src/squirtl/}
        echo "tests/${rest%%/*}"
        naming "$path" | reach named ;;
      *)
        naming "$path" | reach named ;;
    esac
  done
}

forwarded=$#
base=$(git merge-base HEAD origin/main)
changed=$(
  git diff --name-only --no-renames "$base" \
    && git ls-files --exclude-standard --others
)
selected=$(reach <<<"$changed" | importers | sort -u)

while IFS= read -r argument; do
  [[ ! -e "${argument%%::*}" ]] || set -- "$@" "$argument"
done <<<"$selected"

(( $# > forwarded )) \
  || { echo "No test module reaches a file changed since $base"; exit 0; }
pytest "$@"
